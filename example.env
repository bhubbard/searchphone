# SearchPhone OSINT Configuration
# Rename this file to .env and configure your desired API keys

# Numverify API (https://numverify.com/) - Phone & carrier validation
NUMVERIFY_KEY=

# NumLookup API (https://www.numlookup.com / https://numlookupapi.com/) - Reverse phone lookup
NUMLOOKUP_KEY=

# SerpAPI (https://serpapi.com/) - Google search engine scraper API
SERPAPI_KEY=

# Brave Search API (https://brave.com/search/api/) - Privacy-first search API
BRAVE_API_KEY=

# GitHub Personal Access Token (https://github.com/settings/tokens) - Code repository search
GITHUB_TOKEN=

# Default Reports Output Directory
SEARCHPHONE_REPORT_DIR=reports

# Optional Proxy / Tor Routing (e.g. socks5://127.0.0.1:9050 or http://127.0.0.1:8080)
# SEARCHPHONE_PROXY=socks5://127.0.0.1:9050

# Redact sensitive PII by default (0 or 1)
SEARCHPHONE_REDACT=0
